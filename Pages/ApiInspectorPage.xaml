<Page x:Class="SdkComponentLab.Pages.ApiInspectorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:SdkComponentLab.Pages">
    <Grid RowSpacing="12" Padding="0,16,0,0">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <TextBlock x:Uid="ApiInspectorPage_TextBlock1" Text="Changes apply to live lab objects. Return to the corresponding page to see the result. Choosing a scenario creates new series and axes; reopening the inspector refreshes the object list." TextWrapping="Wrap" />
        <StackPanel Grid.Row="1" Spacing="8">
            <ComboBox x:Uid="ApiInspectorPage_TargetPicker" x:Name="TargetPicker" Header="Object" HorizontalAlignment="Stretch" SelectionChanged="TargetChanged" AutomationProperties.AutomationId="ApiTarget" />
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBox x:Uid="ApiInspectorPage_Search" x:Name="Search" Header="Search properties" TextChanged="SearchChanged" AutomationProperties.AutomationId="ApiSearch" />
                <CheckBox x:Uid="ApiInspectorPage_Inherited" x:Name="Inherited" Grid.Column="1" Content="Include inherited WinUI properties" VerticalAlignment="Bottom" Checked="FilterChanged" Unchecked="FilterChanged" AutomationProperties.AutomationId="ApiInherited" />
                <Button x:Uid="ApiInspectorPage_Button2" Grid.Column="2" Content="Catalog of all types" Click="Catalog_Click" VerticalAlignment="Bottom" AutomationProperties.AutomationId="ApiCatalog" />
            </Grid>
        </StackPanel>
        <Grid Grid.Row="2" ColumnSpacing="16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <ListView x:Name="PropertyList" SelectionChanged="PropertyChanged" AutomationProperties.AutomationId="ApiProperties">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:ApiPropertyRow">
                        <StackPanel Spacing="4" Padding="0,4">
                            <TextBlock Text="{x:Bind Name, Mode=OneTime}" FontWeight="SemiBold" />
                            <TextBlock Text="{x:Bind Summary, Mode=OneTime}" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <ScrollViewer Grid.Column="1">
                <StackPanel Spacing="12" Padding="0,0,12,12">
                    <TextBlock x:Uid="ApiInspectorPage_SelectedTitle" x:Name="SelectedTitle" Text="Select a property" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                    <TextBlock x:Name="SelectedDetails" TextWrapping="Wrap" />
                    <TextBox x:Uid="ApiInspectorPage_PropertyValue" x:Name="PropertyValue" Header="New value" AutomationProperties.AutomationId="ApiValue" />
                    <ComboBox x:Uid="ApiInspectorPage_EnumValue" x:Name="EnumValue" Header="Enum value" Visibility="Collapsed" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="ApiEnumValue" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Uid="ApiInspectorPage_ApplyButton" x:Name="ApplyButton" Content="Apply" Click="Apply_Click" IsEnabled="False" AutomationProperties.AutomationId="ApiApply" />
                        <Button x:Uid="ApiInspectorPage_RestoreButton" x:Name="RestoreButton" Content="Restore original" Click="Restore_Click" IsEnabled="False" AutomationProperties.AutomationId="ApiRestore" />
                    </StackPanel>
                    <TextBlock x:Uid="ApiInspectorPage_TextBlock3" Text="Formats: numbers use a dot; nullable values use an empty string; bool uses True / False; Brush uses #RRGGBB, a theme resource key, or an empty string (null); GridLength uses Auto, 140, 2*; Thickness uses 8 or 4,8,4,8. Edit collections, Binding, and DataTemplate in the labs." TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBlock x:Uid="ApiInspectorPage_TextBlock4" Text="Object methods and events" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBox x:Name="Members" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="240" AutomationProperties.AutomationId="ApiMembers" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
        <InfoBar x:Name="Result" Grid.Row="3" IsOpen="False" IsClosable="True" AutomationProperties.AutomationId="ApiResult" />
    </Grid>
</Page>
