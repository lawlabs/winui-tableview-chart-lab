<Page x:Class="SdkComponentLab.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <NavigationView x:Name="Navigation" IsSettingsVisible="False" PaneDisplayMode="Auto" IsBackButtonVisible="Collapsed" AlwaysShowHeader="True"
                    OpenPaneLength="220" CompactModeThresholdWidth="1000" ExpandedModeThresholdWidth="1300"
                    SelectionChanged="Navigation_SelectionChanged" AutomationProperties.AutomationId="Navigation">
        <NavigationView.MenuItems>
            <NavigationViewItem x:Uid="MainPage_NavigationViewItem1" Content="SDK overview" Tag="overview" Icon="Home" AutomationProperties.AutomationId="NavOverview" />
            <NavigationViewItem x:Uid="MainPage_NavigationViewItem2" Content="Tables · TableView" Tag="table" AutomationProperties.AutomationId="NavTable">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE80A;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Uid="MainPage_NavigationViewItem3" Content="Charts · Chart" Tag="charts" AutomationProperties.AutomationId="NavCharts">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE9D9;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Uid="MainPage_NavigationViewItem4" Content="API inspector" Tag="api" AutomationProperties.AutomationId="NavApi">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE943;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>
        <NavigationView.Header>
            <Grid ColumnSpacing="16" Margin="0,0,24,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Uid="MainPage_PageTitle" x:Name="PageTitle" Text="Windows App SDK lab" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock x:Uid="MainPage_TextBlock5" Text="2.5.4-experimental · native WinUI 3 controls" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <ComboBox x:Uid="MainPage_ThemePicker" x:Name="ThemePicker" Grid.Column="1" SelectedIndex="0" SelectionChanged="ThemePicker_SelectionChanged"
                          AutomationProperties.AutomationId="ThemePicker" AutomationProperties.Name="App theme" Width="140">
                    <ComboBoxItem x:Uid="MainPage_ComboBoxItem6" Content="System" /><ComboBoxItem x:Uid="MainPage_ComboBoxItem7" Content="Light" /><ComboBoxItem x:Uid="MainPage_ComboBoxItem8" Content="Dark" />
                </ComboBox>
                <ComboBox x:Name="LanguagePicker" Grid.Column="2" Width="130" SelectedIndex="0"
                          SelectionChanged="LanguagePicker_SelectionChanged" AutomationProperties.AutomationId="LanguagePicker"
                          AutomationProperties.Name="Language">
                    <ComboBoxItem Content="English" /><ComboBoxItem Content="Русский" />
                </ComboBox>
            </Grid>
        </NavigationView.Header>
        <Grid Padding="24,12,24,16">
            <ContentControl x:Name="PageHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
        </Grid>
    </NavigationView>
</Page>
