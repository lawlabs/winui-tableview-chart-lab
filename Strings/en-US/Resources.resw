  <data name="OverviewPage_InfoBar1.Message" xml:space="preserve">
    <value>Released September 29, 2026. These examples use Microsoft's native TableView and Chart from 2.5.4-experimental. The API may change in a future release.</value>
    <comment>OverviewPage.xaml</comment>
  </data>
  <data name="OverviewPage_TextBlock2.Text" xml:space="preserve">
