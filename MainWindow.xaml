<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="SdkComponentLab.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:SdkComponentLab"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="SDK Component Lab — TableView and Chart"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="WindowRoot" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" Title="WinUI TableView &amp; Chart Lab" Subtitle="Windows App SDK 2.5 Experimental">
            <TitleBar.IconSource>
                <FontIconSource Glyph="&#xE9D9;" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            </TitleBar.IconSource>
        </TitleBar>

        <!--
            The Frame hosts pages for your application content. Add your UI to
            MainPage.xaml rather than here so you can use Page features such as
            navigation events and the Loaded lifecycle.
        -->
        <Frame x:Name="RootFrame" Grid.Row="1" />
        <Border x:Name="CaptionBrushProbe" Visibility="Collapsed" Background="{ThemeResource TextFillColorPrimaryBrush}" />
    </Grid>
</Window>
